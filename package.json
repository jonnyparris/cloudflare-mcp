    "typecheck": "npm run types && tsc --noEmit",
    "build:spec": "tsx scripts/build-spec.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.8",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "ai": "^6.0.28",
    "workers-ai-provider": "^3.0.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@types/node": "^25.0.6",
    "cf": "^1.0.0-beta.12",
    "openapi-types": "^12.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7"
  }
