{
  "name": "cloudflare-mcp",
  "version": "0.1.0",
  "description": "MCP server for the entire Cloudflare API using codemode",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "deploy": "npm run build:spec && cf deploy",
